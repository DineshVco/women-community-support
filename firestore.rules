rules_version = '2';

// Looma security rules.
//
// Privacy model
//  * Posts and comments contain NO author id.
//  * The author id lives in `authors/{postId}` and
//    `posts/{postId}/commentAuthors/{commentId}`. Only that author can read
//    them: other members AND moderators cannot see who wrote something.
//  * The owner of the Firebase project can still read everything in the
//    console, so the app is anonymous to other users and moderators, NOT to
//    the project owner. The privacy notice in the app says exactly this.
//
// Moderators are created by hand in the console: add a document
// `moderators/{their uid}` (any fields). The app can never write there.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── helpers ─────────────

    // A real account (email/password or Google). Anonymous "guest" logins
    // are refused everywhere, even if Anonymous sign-in is left switched on
    // in the Firebase console.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Finished Looma sign-up: confirmed "I am a woman" and passed the age
    // step. Both are self-declared in the app; the rules can only check that
    // the steps were completed, not that the answers are true.
    function isWomanMember() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('isWoman', false) == true
        && get(userPath(request.auth.uid)).data.get('birthYear', 0) > 0;
    }

    // Reports store sha256('looma-report:' + uid), never the uid, so
    // moderators cannot tell who reported (or find the reporter's posts).
    // PostRepository.reporterIdFor in the app computes the same value.
    function reporterIdOf() {
      return hashing.sha256('looma-report:' + request.auth.uid).toHexString().lower();
    }

    function isModerator() {
      return signedIn() &&
        exists(/databases/$(database)/documents/moderators/$(request.auth.uid));
    }

    function authorPath(postId) {
      return /databases/$(database)/documents/authors/$(postId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAuthorOf(postId) {
      return signedIn() &&
        exists(authorPath(postId)) &&
        get(authorPath(postId)).data.authorId == request.auth.uid;
    }

    // Keys that changed in an update.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // One post per minute per person.
    function postRateOk() {
      // (The same document is read several times; Firestore counts it once.)
      return !exists(userPath(request.auth.uid)) ||
        !('lastPostAt' in get(userPath(request.auth.uid)).data) ||
        request.time >
          get(userPath(request.auth.uid)).data.lastPostAt + duration.value(60, 's');
    }

    // ───────────── posts ─────────────

    function validNewPost(postId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['alias', 'categoryId', 'title', 'content',
                               'timestamp', 'flagCount', 'meTooCount',
                               'commentCount', 'status'])
        && d.keys().hasAll(['alias', 'categoryId', 'title', 'content',
                            'timestamp', 'flagCount', 'meTooCount',
                            'commentCount', 'status'])
        && d.alias is string && d.alias.size() > 0 && d.alias.size() <= 40
        && d.categoryId in ['health_wellness', 'education',
                            'career_development', 'personal_safety']
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.content is string && d.content.size() >= 1 && d.content.size() <= 5000
        && d.timestamp == request.time
        && d.flagCount == 0 && d.meTooCount == 0 && d.commentCount == 0
        && d.status == 'visible'
        && existsAfter(authorPath(postId))
        && getAfter(authorPath(postId)).data.authorId == request.auth.uid
        && postRateOk()
        && getAfter(userPath(request.auth.uid)).data.lastPostAt == request.time;
    }

    // A member reports a post: +1 flag, and the 3rd flag hides the post.
    function isReportUpdate(postId) {
      let report = /databases/$(database)/documents/reports/$(postId + '_' + reporterIdOf());
      let oldStatus = resource.data.get('status', 'visible');
      let newFlags = request.resource.data.get('flagCount', 0);
      return changedKeys().hasOnly(['flagCount', 'status'])
        && !exists(report) && existsAfter(report)
        && newFlags == resource.data.get('flagCount', 0) + 1
        && request.resource.data.status ==
             ((newFlags >= 3 && oldStatus == 'visible') ? 'hidden' : oldStatus);
    }

    // A member taps "Me too" (+1) or takes it back (-1).
    function isMeTooUpdate(postId) {
      let reaction = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
      let oldCount = resource.data.get('meTooCount', 0);
      return changedKeys().hasOnly(['meTooCount']) && (
        (!exists(reaction) && existsAfter(reaction) &&
           request.resource.data.meTooCount == oldCount + 1) ||
        (exists(reaction) && !existsAfter(reaction) &&
           request.resource.data.meTooCount == oldCount - 1)
      );
    }

    // A reply was added: +1 reply count.
    function isReplyCountUpdate() {
      return changedKeys().hasOnly(['commentCount'])
        && request.resource.data.commentCount ==
             resource.data.get('commentCount', 0) + 1;
    }

    function isModeratorUpdate() {
      return isModerator() && changedKeys().hasOnly(['status', 'flagCount']);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if isWomanMember() && validNewPost(postId);
      allow update: if signedIn() && (
        isReportUpdate(postId) ||
        isMeTooUpdate(postId) ||
        isReplyCountUpdate() ||
        isModeratorUpdate()
      );
      allow delete: if isAuthorOf(postId);

      // ───────────── comments ─────────────

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isWomanMember()
          && request.resource.data.keys().hasOnly(
               ['alias', 'content', 'timestamp', 'parentCommentId'])
          && request.resource.data.keys().hasAll(
               ['alias', 'content', 'timestamp', 'parentCommentId'])
          && request.resource.data.alias is string
          && request.resource.data.alias.size() > 0
          && request.resource.data.alias.size() <= 40
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000
          && request.resource.data.timestamp == request.time
          && (request.resource.data.parentCommentId == null ||
              request.resource.data.parentCommentId is string)
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.get('status', 'visible') == 'visible'
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/commentAuthors/$(commentId))
          && getAfter(/databases/$(database)/documents/posts/$(postId)/commentAuthors/$(commentId))
               .data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() &&
          exists(/databases/$(database)/documents/posts/$(postId)/commentAuthors/$(commentId)) &&
          get(/databases/$(database)/documents/posts/$(postId)/commentAuthors/$(commentId))
            .data.authorId == request.auth.uid;
      }

      match /commentAuthors/{commentId} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow read, delete: if signedIn() &&
          resource.data.authorId == request.auth.uid;
        allow update: if false;
      }

      // ───────────── "Me too" reactions ─────────────

      match /reactions/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    // ───────────── who wrote what (locked) ─────────────

    match /authors/{postId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow read, delete: if signedIn() &&
        resource.data.authorId == request.auth.uid;
      allow update: if false;
    }

    // ───────────── private profile + bookkeeping ─────────────
    //
    // users/{uid} holds: lastPostAt (rate limit), isWoman (women-only
    // self-confirmation), birthYear (the YEAR only, after the age check),
    // createdAt, and aliasKey (her secret key for post and reply aliases).
    // Only the owner can read, create or update it; nobody else can.
    // isWoman can only ever be set to true; birthYear, createdAt and aliasKey
    // are set once and never changed. She can delete it (account deletion),
    // but not within 60 seconds of posting, so deleting and re-creating it
    // cannot be used to dodge the 1-post-per-minute limit.
    // NOTE: the app checks the exact age; the rules can only check the year.
    // Keep 18 here in step with Membership.minimumAge in the app.

    function userKeysChanged() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function validUserDoc() {
      let d = request.resource.data;
      let changed = userKeysChanged();
      return d.keys().hasOnly(['lastPostAt', 'isWoman', 'birthYear', 'createdAt',
                               'aliasKey'])
        // aliasKey: 64 hex characters (256 random bits), set once.
        && (!changed.hasAny(['aliasKey']) || (
             (resource == null || !('aliasKey' in resource.data))
             && d.aliasKey is string
             && d.aliasKey.matches('[0-9a-f]{64}')))
        && (!changed.hasAny(['lastPostAt']) || d.lastPostAt == request.time)
        // createdAt: server time, set once, never changed.
        && (!changed.hasAny(['createdAt']) || (
             (resource == null || !('createdAt' in resource.data))
             && d.createdAt == request.time))
        && (!changed.hasAny(['isWoman']) || d.isWoman == true)
        && (!changed.hasAny(['birthYear']) || (
             (resource == null || !('birthYear' in resource.data))
             && d.get('isWoman', false) == true
             && d.birthYear is int
             && d.birthYear >= 1900
             && d.birthYear <= request.time.year() - 18));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validUserDoc();
      // Only as part of "Delete my account and data", and not within a
      // minute of her last post.
      allow delete: if signedIn() && request.auth.uid == uid
        && (!('lastPostAt' in resource.data)
            || request.time > resource.data.lastPostAt + duration.value(60, 's'));

      // Saved posts: a private bookmark list. Only she can see it.
      match /saved/{postId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    // ───────────── reports ─────────────

    match /reports/{reportId} {
      allow create: if signedIn()
        && reportId == request.resource.data.postId + '_' + reporterIdOf()
        && request.resource.data.keys().hasOnly(
             ['postId', 'postTitle', 'reason', 'reporterId', 'createdAt', 'status'])
        && request.resource.data.reporterId == reporterIdOf()
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.postTitle is string
        && request.resource.data.postTitle.size() <= 120
        && request.resource.data.reason in [
             'Harassment or hate',
             'Unsafe or harmful advice',
             'Spam or advertising',
             'Private information',
             'Something else'];
      // Reporters can read their own reports (to see the outcome).
      // (`resource == null` lets the app check "did I already report this?"
      // for a report that does not exist yet.)
      allow read: if isModerator() ||
        (signedIn() &&
          (resource == null || resource.data.reporterId == reporterIdOf()));
      allow update: if isModerator()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedAt'])
        && request.resource.data.status in ['dismissed', 'removed']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // ───────────── my replies, for "Delete my account and data" ─────────────
    // A collection-group query (`commentAuthors` where authorId == me) finds
    // every reply she wrote. She can only ever read her own.

    match /{path=**}/commentAuthors/{commentId} {
      allow read: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    // ───────────── Looma Connect: chat profiles ─────────────
    //
    // chatProfiles/{chatId}: alias, avatar, bio, interests, lookingFor, open.
    //
    // The document id is NOT the uid. It is sha256('looma-chat:' + uid) in
    // hex. Why: post aliases are computed from the uid, so anyone who knew a
    // uid could find that person's posts. A one-way hash lets the rules
    // check ownership without ever showing the uid to other members.
    // (ChatRepository.chatIdFor in the app computes the same value.)
    //
    // Other women members can read a profile only while open == true, and
    // must query with where('open', '==', true). Only the owner can write or
    // delete it.

    function chatIdOf(uid) {
      return hashing.sha256('looma-chat:' + uid).toHexString().lower();
    }

    function isMyChatProfile(chatId) {
      return signedIn() && chatId == chatIdOf(request.auth.uid);
    }

    // Links, web addresses, emails, @handles, phone numbers (9+ digits).
    // Same patterns as ContactFilter in the app.
    function noContact(text) {
      return !text.matches('(?i).*(https?://|www[.]).*')
        && !text.matches('(?i).*[a-z0-9-]+[.](com|net|org|my|io|me|co|app|ly|gg|xyz|info|biz)([^a-z].*)?')
        && !text.matches('.*@[A-Za-z0-9_].*')
        && !text.matches('.*([0-9][ ()+.-]*){9,}.*');
    }

    // 24 hours since sign-up before "Open to chat" can be on.
    function accountOldEnough() {
      let user = get(userPath(request.auth.uid)).data;
      return 'createdAt' in user
        && request.time >= user.createdAt + duration.value(24, 'h');
    }

    function validChatProfile() {
      let d = request.resource.data;
      let fields = ['alias', 'avatarId', 'bio', 'interests', 'lookingFor',
                    'open', 'createdAt', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.alias is string
        && d.alias.matches('[A-Za-z0-9 _.-]{3,20}')
        && !d.alias.matches('.*[0-9]{7,}.*')
        && noContact(d.alias)
        && d.avatarId in ['cat_01', 'cat_02', 'cat_03', 'cat_04', 'cat_05',
                          'cat_06', 'cat_07', 'cat_08', 'cat_09', 'cat_10',
                          'cat_11', 'cat_12']
        && d.bio is string && d.bio.size() <= 120 && noContact(d.bio)
        && d.interests is list && d.interests.size() <= 5
        && d.interests.toSet().size() == d.interests.size()
        && d.interests.hasOnly(['health', 'study', 'career', 'safety',
                                'family', 'money', 'friendship',
                                'mental_wellbeing', 'new_in_town', 'hobbies'])
        && d.lookingFor is list && d.lookingFor.size() <= 2
        && d.lookingFor.toSet().size() == d.lookingFor.size()
        && d.lookingFor.hasOnly(['talk', 'study_buddy', 'career_advice',
                                 'friends'])
        && d.open is bool
        && (d.open == false || accountOldEnough())
        && d.updatedAt == request.time
        && (resource == null
              ? d.createdAt == request.time
              : d.createdAt == resource.data.createdAt);
    }

    match /chatProfiles/{chatId} {
      allow read: if isMyChatProfile(chatId)
        || (isWomanMember() && resource.data.open == true);
      allow create, update: if isWomanMember() && isMyChatProfile(chatId)
        && validChatProfile();
      // Turning "Open to chat" off is an update. Deleting happens only when
      // she deletes her account.
      allow delete: if isMyChatProfile(chatId);
    }

    // ───────────── badges (set by an admin script only) ─────────────
    // badges/{uid}: { foundingMember: true } for the first 50 accounts.
    // Written with the Admin SDK (tool/founding-members.mjs), never the app.

    match /badges/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ───────────── moderators (read your own, never write) ─────────────

    match /moderators/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
